      "source": [
        "\n",
        "INF = 99999\n",
        "\n",
        "n = int(input(\"Enter number of vertices: \"))\n",
        "\n",
        "print(\"Enter the adjacency matrix:\")\n",
        "print(\"Enter 99999 if there is no direct edge\")\n",
        "\n",
        "graph = []\n",
        "\n",
        "for i in range(n):\n",
        "    row = list(map(int, input().split()))\n",
        "    graph.append(row)\n",
        "\n",
        "# Floyd-Warshall Algorithm\n",
        "for k in range(n):\n",
        "    for i in range(n):\n",
        "        for j in range(n):\n",
        "            graph[i][j] = min(\n",
        "                graph[i][j],\n",
        "                graph[i][k] + graph[k][j]\n",
        "            )\n",
        "\n",
        "# Display shortest distance\n",
        "print(\"\\nShortest Distance Matrix:\")\n",
        "\n",
        "for i in range(n):\n",
        "    for j in range(n):\n",
        "        if graph[i][j] == INF:\n",
        "            print(\"INF\", end=\" \")\n",
        "        else:\n",
        "            print(graph[i][j], end=\" \")\n",
        "    print()\n"
      ]
    },
