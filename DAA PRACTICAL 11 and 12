        "\n",
        "from itertools import permutations\n",
        "\n",
        "n = int(input(\"Enter number of cities: \"))\n",
        "\n",
        "print(\"Enter the cost matrix:\")\n",
        "cost = []\n",
        "\n",
        "for i in range(n):\n",
        "    row = list(map(int, input().split()))\n",
        "    cost.append(row)\n",
        "\n",
        "min_cost = float('inf')\n",
        "best_path = None\n",
        "\n",
        "# Fix city 0 as starting city\n",
        "for path in permutations(range(1, n)):\n",
        "\n",
        "    route = (0,) + path + (0,)\n",
        "    total_cost = 0\n",
        "\n",
        "    for i in range(n):\n",
        "        total_cost += cost[route[i]][route[i + 1]]\n",
        "\n",
        "    if total_cost < min_cost:\n",
        "        min_cost = total_cost\n",
        "        best_path = route\n",
        "\n",
        "print(\"\\nMinimum Cost:\", min_cost)\n",
        "\n",
        "print(\"Best Route:\", end=\" \")\n",
        "for city in best_path:\n",
        "    print(city, end=\" \")\n"
